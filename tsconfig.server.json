{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true
  },
  "include": [
    "*.ts",
    "scripts/**/*.ts",
    "src/**/*.ts",
    "examples/*/src/**/*.ts",
    "examples/*/test/**/*.ts",
    "plugins/*/src/**/*.ts",
    "plugins/*/test/**/*.ts",
    "apps/*/src/**/*.ts",
    "apps/*/test/**/*.ts"
  ],
  "exclude": ["apps/web/**"]
}
