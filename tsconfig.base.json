{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext"],
    "types": ["bun"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "moduleDetection": "force",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "useDefineForClassFields": true,
    "skipLibCheck": true,
    "plugins": [
      {
        "name": "@effect/language-service",
        "namespaceImportPackages": ["effect"],
        "ignoreEffectErrorsInTscExitCode": false,
        "ignoreEffectWarningsInTscExitCode": false,
        "allowedUnstableApis": ["@effect/vitest"],
        "diagnosticSeverity": {
          "preferNamespaceImport": "error",
          "leakingRequirements": "error",
          "missingEffectServiceDependency": "error",
          "preferSchemaOverJson": "error",
          "nodeBuiltinImport": "error",
          "globalDate": "error",
          "globalConsole": "error",
          "globalRandom": "error",
          "globalTimers": "error",
          "globalFetch": "error",
          "globalFetchInEffect": "error",
          "cryptoRandomUUID": "error"
        },
        "overrides": [
          {
            "include": ["scripts/**/*.ts"],
            "options": {
              "diagnosticSeverity": {
                "nodeBuiltinImport": "off",
                "globalConsole": "off"
              }
            }
          }
        ]
      }
    ]
  }
}
